# ------------------------------------------------------------------
# Example nginx server block for wahealth.konnorkooi.com
# (static Next.js export, deployed by .github/workflows/deploy.yml).
#
# This lives ON THE SERVER, not in the deploy — the GitHub Action only rsyncs
# the built `out/` files into the web root; it never touches nginx. Treat this
# as one-time setup, re-applied only when you change headers.
#
# One-time server setup:
#   1. sudo mkdir -p /var/www/wahealth.konnorkooi.com
#      sudo chown -R $USER:www-data /var/www/wahealth.konnorkooi.com
#   2. Point a DNS A/AAAA record for wahealth.konnorkooi.com at this server.
#   3. sudo cp deploy/security-headers.conf \
#           /etc/nginx/snippets/wahealth-headers.conf
#   4. sudo cp deploy/nginx-wahealth.conf.example \
#           /etc/nginx/sites-available/wahealth.konnorkooi.com
#      sudo ln -s /etc/nginx/sites-available/wahealth.konnorkooi.com \
#                 /etc/nginx/sites-enabled/
#   5. sudo certbot --nginx -d wahealth.konnorkooi.com
#      (certbot fills in the ssl_certificate lines below)
#   6. sudo nginx -t && sudo systemctl reload nginx
#
# Verify:
#   curl -sI https://wahealth.konnorkooi.com | grep -i -E 'content-security|strict-transport|x-frame'
#   then open the site and confirm the map tiles load (a blank grey map means
#   the CSP connect-src does not allow the tile host).
# ------------------------------------------------------------------

server {
    listen 443 ssl;
    http2 on;
    server_name wahealth.konnorkooi.com;

    root /var/www/wahealth.konnorkooi.com;
    index index.html;

    # --- TLS (certbot manages these lines) ---
    # ssl_certificate     /etc/letsencrypt/live/wahealth.konnorkooi.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/wahealth.konnorkooi.com/privkey.pem;

    include /etc/nginx/snippets/wahealth-headers.conf;

    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_types text/plain text/css application/javascript application/json
               image/svg+xml application/xml application/geo+json;

    # next.config.ts sets trailingSlash, so routes export as
    # <route>/index.html and this resolves cleanly.
    location / {
        try_files $uri $uri/ $uri.html /index.html;
    }

    # Hashed build assets are immutable — cache hard.
    # (Re-include headers: a nested add_header would otherwise drop them.)
    location /_next/static/ {
        include /etc/nginx/snippets/wahealth-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
    }

    location ~* \.(?:woff2?|png|jpe?g|webp|avif|svg|ico)$ {
        include /etc/nginx/snippets/wahealth-headers.conf;
        add_header Cache-Control "public, max-age=2592000" always;
        access_log off;
    }

    # HTML must revalidate so deploys show up immediately.
    location ~* \.html$ {
        include /etc/nginx/snippets/wahealth-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    error_page 404 /404.html;
}

# Redirect plain HTTP to HTTPS.
server {
    listen 80;
    server_name wahealth.konnorkooi.com;
    return 301 https://$host$request_uri;
}
